# Settings for one issue loop. Every script in this folder reads this file.
# Keep this folder OUTSIDE the implementer's checkout.

# Driver name of the implementer session.
IMPL=impl
# The implementer's checkout. The orchestrator reads it and never writes to it.
REPO=/path/to/implementer/checkout
# The branch a merge deploys from.
BASE=main
# Name of the deploy workflow in GitHub Actions. Empty: the gate skips the deploy check.
DEPLOY_WORKFLOW=Deploy
# A URL that answers only when the live app works. Pick a route that reads the
# database: a front page can answer 200 on a dead app. Empty: the gate skips it.
ALIVE_URL=
# Files that are the loop's own machine (CI, deploy, hooks, schema). The gate
# names every PR that touched one, so the orchestrator tells the human.
MACHINE_FILES='^(\.github/|Dockerfile|docker-compose|\.claude/)'
# Minutes after which wait.sh prints TIMEOUT.
TASK_LIMIT_MIN=100
# The driver: a file in this folder that defines drv_send, drv_wait, drv_read,
# drv_status and drv_start. See references/driver.md in the skill.
DRIVER=driver-herdr.sh
# herdr only: the workspace new tabs open in. Empty: herdr's default.
HERDR_WORKSPACE=
# Permission mode for sessions the loop starts. Never skip permissions.
PERMISSION_MODE=auto
