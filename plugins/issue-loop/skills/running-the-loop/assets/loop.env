# Settings for one issue loop. Every script in this folder reads this file.
# Keep this folder OUTSIDE the implementer's checkout.

# Driver name of the implementer session.
IMPL=impl
# The implementer's checkout. The orchestrator reads it and never writes to it.
REPO=/path/to/implementer/checkout
# The branch a merge deploys from.
BASE=main
# Name of the deploy workflow in GitHub Actions. Empty: the gate skips the deploy check.
DEPLOY_WORKFLOW=Deploy
# Commit types, as an extended regex, that must reach live, such as 'feat|fix|perf'.
# The gate fails when live lags BASE only if a commit after live starts with one.
# Empty: every commit must reach live.
LIVE_TYPES=
# A URL that answers only when the live app works. Pick a route that reads the
# database: a front page can answer 200 on a dead app. Empty: the gate skips it.
ALIVE_URL=
# Files that are the loop's own machine (CI, deploy, hooks, schema). The gate
# names every PR that touched one, so the orchestrator tells the human.
MACHINE_FILES='^(\.github/|Dockerfile|docker-compose|\.claude/)'
# Minutes after which wait.sh prints TIMEOUT, once per task. A wait.sh started
# after that watches on with no limit.
TASK_LIMIT_MIN=100
# The driver: a file in this folder that defines drv_send, drv_wait, drv_read,
# drv_status and drv_start. See references/driver.md in the skill.
DRIVER=driver-herdr.sh
# herdr only: the workspace new tabs open in. Empty: herdr's default.
HERDR_WORKSPACE=
# Permission mode for sessions the loop starts.
PERMISSION_MODE=bypassPermissions
# Where the code review runs: session (a review subagent of the implementer,
# rules 7 and 16) or ci (CI reviews every PR, and a PR on a code-owned path
# waits for the owner's review: rules-ci.md). Unset: session.
REVIEW_IN=session
# Optional: a file of KEY=value lines, mode 600, outside every checkout, that
# start.sh loads into the implementer's session only, such as GH_TOKEN=<token
# of a bot account>. Empty: the implementer runs with your own credentials.
IMPL_ENV_FILE=
# The GitHub logins whose issues and comments the loop reads, in quotes with a
# space between, such as 'owner-login bot-login'.
# Anyone can comment on a public repo's issues, so the queue skips an issue by
# anyone else, next.sh refuses to brief one, and the brief reads only these
# authors' text. Empty: the repo's owner, the account of the GH_TOKEN in
# IMPL_ENV_FILE, and with REVIEW_IN=ci github-actions[bot]. A list here
# replaces that default, so name the owner in it too.
TRUSTED_AUTHORS=
# The issue-loop version the scripts run. latest: the installed plugin. An exact
# version, such as 0.9.0: that version's folder in the plugin cache, to roll back
# a bad release. next.sh resolves it once per task.
ISSUE_LOOP_VERSION=latest
