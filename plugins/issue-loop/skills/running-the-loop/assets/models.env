# The model per role and per harness for this loop. lib.sh reads this file;
# no other file in the loop names a model. HARNESS picks the column.
HARNESS=CLAUDE

# Claude Code. A value is what `claude --model` and the Agent tool's model take.
# A session with a bigger context window takes the alias with a suffix, such as [1m]: try it once with start.sh, since the driver hands the value on to a shell.
# Orchestrator sessions: start.sh, for every session not named IMPL in loop.env.
CLAUDE_ORCH_MODEL=opus
# The implementer session: start.sh, for the session named IMPL in loop.env.
CLAUDE_IMPL_MODEL=opus
# Subagents that code parts side by side: next.sh writes it into rule 3 of the brief.
CLAUDE_CODER_MODEL=haiku
# Review subagents (rules 7 and 16): next.sh writes it into rule 3. It must
# never match REVIEW_NOT: next.sh refuses to send a brief that would.
CLAUDE_REVIEW_MODEL=opus
# The advisor: start.sh passes `claude --advisor <model>`, so it is set per
# session. Claude Code 2.1.304 parses that flag but leaves it out of --help;
# the documented way is the advisorModel setting (or /advisor in a session).
# Empty: start.sh passes no flag, for a Claude Code without --advisor.
CLAUDE_ADVISOR_MODEL=fable

# Codex: every value empty. The loop has never run under Codex, and
# driver-herdr.sh starts only Claude Code sessions (--kind claude).
# Sessions: empty, untested; Codex would take them as `codex --model <name>`.
CODEX_ORCH_MODEL=
CODEX_IMPL_MODEL=
# Subagents: empty, untested; nobody has checked how Codex picks a
# subagent's model, so the brief cannot name one. next.sh refuses empty values.
CODEX_CODER_MODEL=
CODEX_REVIEW_MODEL=
# Advisor: empty, Codex has no advisor tool.
CODEX_ADVISOR_MODEL=

# A review model that matches this (grep -iE) is refused, in every harness.
REVIEW_NOT=haiku
