#!/usr/bin/env bash
# Fails the push when a tracked file at HEAD passes the file-size limit or a
# folder passes the fan-out limit.
# Turn on once per clone: git config core.hooksPath .githooks
set -euo pipefail
# $(...) strips every newline that ends the name, so the output ends in a mark.
top=$(git rev-parse --show-toplevel && echo x)
cd "${top%$'\n'x}"
scripts/check-file-size
scripts/check-fan-out --all
