{#- Heimatblatt: a warm local paper from the Kinzig valley that grew up. -#}
{%- set local_id = (edition.sections|selectattr('local')|map(attribute='id')|first) or none -%}
{%- import 'heimatblatt/macros.html.j2' as hb -%}
{%- macro story(st, kind) -%}
<article id="{{ st.id }}" lang="{{ st.lang }}" class="story {{ kind }} {{ 'has-img' if st.image else 'no-img' }}">
  {%- if st.image %}{{ hb.figure(st.image) }}{% endif %}
  <div class="head">
    {%- if st.update_note %}<span class="flag">{{ 'Fortsetzung' if st.lang == 'de' else 'Follow-up' }}</span>{% endif %}
    <h3 class="hl">{{ st.headline }}</h3>
    {%- if st.dek %}<p class="dek">{{ st.dek }}</p>{% endif %}
    {{ hb.meta(st) }}
  </div>
  <div class="sum">{{ hb.paras(st.summary) }}</div>
  {%- if st.update_note or st.followups %}<div class="side">{{ hb.follow(st) }}</div>{% endif %}
</article>
{%- endmacro -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ edition.title }}, {{ edition.date_display }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet">
<style>
{% include 'heimatblatt/base.css.j2' %}
.nav{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 22px;margin:12px 0 0;padding:0 0 12px;
  font-family:var(--font-head);font-size:15px;border-bottom:1px solid var(--rule)}
.nav a{text-decoration:none;color:var(--ink-soft)}
.nav a:hover{color:var(--accent)}
.nav a.home{color:var(--local);font-weight:600}

{% include 'heimatblatt/story.css.j2' %}
{% include 'heimatblatt/layout.css.j2' %}
.also h4,.briefs h2{font-family:var(--font-head);font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--local);margin:0 0 8px}
.also ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:6px 32px}
.also li{font-family:var(--font-head);font-size:16px;line-height:1.35;padding-left:16px;position:relative}
.also li::before{content:"";position:absolute;left:0;top:.5em;width:6px;height:6px;background:var(--local);transform:rotate(45deg)}
.also .bsrc{display:block;font-size:12.5px;color:var(--muted)}

/* ---------- briefs ---------- */
.briefs{margin-top:44px;border-top:3px double var(--ink);padding-top:10px}
.briefs h2{color:var(--accent);font-size:14px}
.briefs ol{list-style:none;margin:10px 0 0;padding:0;columns:3 260px;column-gap:40px;column-rule:1px solid var(--rule)}
.briefs li{break-inside:avoid;padding:0 0 12px;font-family:var(--font-head);font-size:16.5px;line-height:1.35}
.briefs .bsec{display:block;font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--accent);font-weight:600}
.briefs .bsrc{font-size:13px;color:var(--muted)}

/* ---------- footer ---------- */
.foot{text-align:center;font-family:var(--font-head);color:var(--ink-soft);font-size:15px;padding-top:4px}
.foot .emblem{width:70px;margin:0 auto 10px;color:var(--muted)}
.foot p{margin:4px 0}
.foot .prev a{color:var(--accent);font-weight:600}
.foot .hint{font-family:var(--font-mono);font-size:12.5px;color:var(--muted)}
.foot .asked{font-size:14px;color:var(--muted);list-style:none;padding:0;margin:10px auto 4px;max-width:560px}

/* ---------- narrower screens ---------- */
@media (max-width:980px){
  .lead,.lead.no-img{grid-template-columns:1fr;grid-template-areas:"pic" "head" "sum" "side";gap:8px}
  .lead:not(:has(.side)) .sum{columns:auto}
  .feature,.feature.no-img{grid-template-columns:1fr}
  .feature > *,.feature.no-img > *{grid-column:1 !important;grid-row:auto !important}
  .locals{grid-template-columns:1fr}
}
@media (max-width:640px){
  body{font-size:16.5px}
  .page{padding:0 16px 36px}
  .ears{grid-template-columns:1fr 1fr;gap:10px}
  .ears .mid{grid-column:1 / -1;grid-row:1;justify-self:center}
  .emblem{width:120px}
  .title{margin-top:10px}
  .dateline{font-size:12px;letter-spacing:.04em}
  .nav{gap:2px 14px;font-size:14px}
  .lead .sum{font-size:17px}
  .grid{grid-template-columns:1fr}
  .grid > .story + .story::before{display:none}
  .grid > .story{padding:0 0 22px;margin-bottom:22px;border-bottom:1px solid var(--rule)}
  .grid > .story:last-child{border-bottom:0;margin-bottom:0;padding-bottom:0}
  .region{padding:20px 16px 22px;margin-left:-4px;margin-right:-4px;outline-offset:3px}
  .region .emblem{width:64px}
  .locals .story{grid-template-columns:96px minmax(0,1fr);gap:0 14px}
  .locals .pic{grid-row:1}
  .locals .head{grid-row:1}
  .locals .sum,.locals .side{grid-column:1 / -1}
  .briefs ol{columns:1}
}
</style>
<script>
// A hotlinked photo can vanish; fall back to the text-only layout instead of an empty frame.
function hb_noimg(img){const a=img.closest('article');img.closest('figure').remove();if(a){a.classList.remove('has-img');a.classList.add('no-img')}}
</script>
{%- if edition.design_overrides %}<style>:root{ {% for k,v in edition.design_overrides.items() %}--{{k}}:{{v}};{% endfor %} }</style>{% endif %}
</head>
<body>
<div class="page">

<header class="mast">
  <div class="ears">
    <div class="ear l">
      {%- if edition.weather %}
      <span class="temps">{{ edition.weather.high_c }}°<span class="lo"> / {{ edition.weather.low_c }}°</span></span><br>
      <b>{{ edition.weather.place }}:</b> {{ edition.weather.summary }}
      {%- endif %}
    </div>
    <div class="mid">{{ hb.emblem('emblem') }}</div>
    <div class="ear r">
      <b>Ausgabe Nr. {{ edition.number }}</b><br>
      {{ edition.sections|map(attribute='stories')|map('length')|sum + 1 }} Geschichten, {{ edition.sections|length }} Ressorts
    </div>
  </div>
  <h1 class="title">{{ edition.title }}</h1>
  <p class="tagline">{{ edition.tagline }}</p>
  <div class="dateline"><span>{{ edition.date_display }}</span><span>Nr. {{ edition.number }}</span></div>
  <nav class="nav" aria-label="Ressorts">
    {%- for s in edition.sections %}<a href="#sec-{{ s.id }}"{% if s.id == local_id %} class="home"{% endif %}>{{ s.name }}</a>{% endfor -%}
    {%- if edition.briefs %}<a href="#kurz">In Kürze</a>{% endif -%}
  </nav>
</header>

<main>
<section class="front" aria-label="Aufmacher">
  {{ story(edition.lead, 'lead') }}
</section>

{%- for s in edition.sections %}
{%- set first = s.stories[0] if s.stories else none %}
{%- if s.id == local_id %}
<section class="region" id="sec-{{ s.id }}">
  <div class="sec-head">
    {{ hb.emblem('emblem') }}
    <div>
      <h2><em>Aus der Region</em></h2>
      <div class="sec-sub"><b>{{ s.name }}</b>{% if s.kicker %}, {{ s.kicker }}{% endif %}</div>
    </div>
  </div>
  {%- if first %}{{ story(first, 'feature') }}{% endif %}
  {%- if s.stories|length > 1 %}
  <div class="locals">
    {%- for st in s.stories[1:] %}{{ story(st, 'small') }}{% endfor %}
  </div>
  {%- endif %}
  {%- set local_briefs = edition.briefs|selectattr('section', 'equalto', s.id)|list %}
  {%- if local_briefs %}
  <div class="also">
    <h4>Außerdem aus der Region</h4>
    <ul>{% for b in local_briefs %}<li><a href="{{ b.url }}" rel="noopener">{{ b.headline }}</a><span class="bsrc">{{ b.source }}</span></li>{% endfor %}</ul>
  </div>
  {%- endif %}
</section>
{%- else %}
<section class="section" id="sec-{{ s.id }}">
  <div class="sec-head"><h2>{{ s.name }}</h2>{% if s.kicker %}<span class="kicker">{{ s.kicker }}</span>{% endif %}</div>
  {%- if first %}{{ story(first, 'feature') }}{% endif %}
  {%- if s.stories|length > 1 %}
  <div class="grid">
    {%- for st in s.stories[1:] %}{{ story(st, 'small') }}{% endfor %}
  </div>
  {%- endif %}
</section>
{%- endif %}
{%- if s.id == local_id or loop.index == 4 %}
<div class="orn" aria-hidden="true"><svg viewBox="0 0 46 12" fill="currentColor"><rect x="20" y="3" width="6" height="6" transform="rotate(45 23 6)"/><circle cx="9" cy="6" r="1.6"/><circle cx="37" cy="6" r="1.6"/></svg></div>
{%- endif %}
{%- endfor %}

{%- set other_briefs = edition.briefs|rejectattr('section', 'equalto', local_id)|list %}
{%- if other_briefs %}
<section class="briefs" id="kurz">
  <h2>In Kürze</h2>
  <ol>
    {%- for b in other_briefs %}
    {%- set sec = edition.sections|selectattr('id', 'equalto', b.section)|first %}
    <li><span class="bsec">{{ sec.name if sec else b.section }}</span><a href="{{ b.url }}" rel="noopener">{{ b.headline }}</a> <span class="bsrc">{{ b.source }}</span></li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}
</main>

<div class="orn" aria-hidden="true"><svg viewBox="0 0 46 12" fill="currentColor"><rect x="20" y="3" width="6" height="6" transform="rotate(45 23 6)"/><circle cx="9" cy="6" r="1.6"/><circle cx="37" cy="6" r="1.6"/></svg></div>
<footer class="foot">
  {{ hb.emblem('emblem') }}
  <p>{{ edition.title }}, Nr. {{ edition.number }}, {{ edition.date_display }}</p>
  {%- if edition.previous %}<p class="prev"><a href="{{ edition.previous }}">&larr; Vorherige Ausgabe</a></p>{% endif %}
  <p class="hint">{{ edition.feedback_hint }}</p>
  {%- if edition.recent_feedback %}
  <p class="asked">Ihr Wunsch, umgesetzt:</p>
  <ul class="asked">{% for f in edition.recent_feedback %}<li>{{ f }}</li>{% endfor %}</ul>
  {%- endif %}
  {%- if edition.generated_display %}<p class="hint">Gesetzt {{ edition.generated_display }} Uhr</p>{% endif %}
</footer>
</div>
</body>
</html>
