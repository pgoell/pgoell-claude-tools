{#- Heimatblatt family, part 3 of 3: photos, the lead, sections, the home region, "Außerdem" lists. -#}
.pic{margin:0 0 12px}
.pic img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;filter:var(--photo);background:var(--paper-2);border-radius:1px}
.pic figcaption{font-family:var(--font-head);font-size:11.5px;color:var(--muted);margin-top:4px;text-align:right;letter-spacing:.02em}

/* ---------- front-page lead ---------- */
.front{padding:30px 0 6px}
.lead{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);grid-template-areas:"pic head" "sum side";gap:8px 40px;align-items:start}
.lead .pic{grid-area:pic}.lead .head{grid-area:head;align-self:center}.lead .sum{grid-area:sum}.lead .side{grid-area:side}
.lead:not(:has(.side)) .sum{grid-column:1 / -1;columns:2 30ch;column-gap:40px}
.lead .hl{font-size:clamp(30px,3.6vw,48px);font-weight:700;letter-spacing:-.01em}
.lead .dek{font-size:21px}
.lead .pic img{aspect-ratio:16/10}
.lead .sum{font-size:18px;line-height:1.62}
.lead .side .update{margin-top:4px}
.drop p:first-child::first-letter,.lead .sum p:first-child::first-letter{font-family:var(--font-head);font-weight:700;float:left;font-size:3.5em;line-height:.82;margin:.06em .08em 0 0;color:var(--accent)}
.lead.no-img{grid-template-columns:1fr;grid-template-areas:"head" "sum" "side";max-width:760px;margin:0 auto}

/* ---------- sections ---------- */
.section{margin-top:44px}
.sec-head{display:flex;align-items:baseline;gap:16px;flex-wrap:wrap;border-top:3px double var(--ink);padding-top:10px;margin-bottom:22px}
.sec-head h2{font-size:30px;font-weight:700}
.sec-head .kicker{font-family:var(--font-head);font-style:italic;font-weight:500;color:var(--muted);font-size:17px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0 44px;margin-top:28px;border-top:1px solid var(--rule);padding-top:22px}
/* column rules sit in the gap so every column, and so every photo, keeps the same width */
.grid > .story{position:relative}
.grid > .story + .story::before{content:"";position:absolute;left:-22px;top:0;bottom:0;border-left:1px solid var(--rule)}
.grid .hl{font-size:20px}
.grid .sum{font-size:15.5px;line-height:1.55}
.grid .dek{font-size:16px}

/* a section's first story: image beside text, or text-only with the headline in its own column */
.feature{display:grid;grid-template-columns:minmax(0,6fr) minmax(0,5fr);gap:0 36px;align-items:start}
.feature .pic{grid-column:1;grid-row:1 / span 3}
.feature .head,.feature .sum,.feature .side{grid-column:2}
.feature .hl{font-size:clamp(25px,2.6vw,32px)}
.feature.no-img{grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:0 44px}
.feature.no-img .head{grid-column:1;grid-row:1 / span 2;padding-top:4px}
.feature.no-img .sum,.feature.no-img .side{grid-column:2;max-width:68ch}
.feature.no-img .hl{font-size:clamp(28px,3vw,40px)}
.feature.no-img .dek{font-size:19px}
.feature.no-img .sum{font-size:17.5px}
.feature.no-img .sum p:first-child::first-letter{font-family:var(--font-head);font-weight:700;float:left;font-size:3.3em;line-height:.84;margin:.05em .08em 0 0;color:var(--accent)}
.no-img.small .head::before{content:"";display:block;width:28px;border-top:3px solid var(--accent);margin-bottom:10px}

/* ---------- Aus der Region: the heart of the paper ---------- */
.region{background:var(--local-bg);border:1px solid var(--rule);
  padding:26px 30px 30px;margin-top:40px;position:relative}
.region .sec-head{border-top:0;padding-top:0;align-items:center;gap:6px 18px}
.region .emblem{width:84px;color:var(--local)}
.region .sec-head h2{font-size:clamp(30px,3.4vw,42px);color:var(--local)}
.region .sec-head h2 em{font-style:italic;font-weight:500}
.region .sec-sub{flex-basis:100%;font-family:var(--font-head);color:var(--ink-soft);font-size:16px;margin-top:-2px}
.region .sec-sub b{font-weight:600}
.region .feature .hl{color:var(--ink)}
.region .flag{color:var(--local)}
.region .flag::before,.region .no-img.small .head::before{background:var(--local);border-color:var(--local)}
.locals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 40px;margin-top:28px;border-top:1px solid var(--rule);padding-top:24px}
.locals .story{display:grid;grid-template-columns:150px minmax(0,1fr);gap:0 18px;align-items:start}
.locals .pic{grid-column:1;grid-row:1 / span 3}
.locals .head,.locals .sum,.locals .side{grid-column:2}
.locals .story.no-img{grid-template-columns:1fr}
.locals .story.no-img > *{grid-column:1}
.locals .pic{margin:0}
.locals .pic img{aspect-ratio:1/1}
.locals .pic figcaption{text-align:left;font-size:10.5px}
.locals .hl{font-size:20px}
.locals .sum{font-size:15.5px;line-height:1.55}
.also{margin-top:26px;border-top:1px dashed var(--rule);padding-top:14px}
