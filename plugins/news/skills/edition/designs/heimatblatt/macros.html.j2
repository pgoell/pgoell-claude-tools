{#- Story parts and the Gelnhausen emblem, shared by heimatblatt and tabbed. None reads `edition`. -#}
{%- macro paras(text) -%}
  {%- for p in text.split('\n\n') if p.strip() %}<p>{{ p.strip() }}</p>{% endfor -%}
{%- endmacro -%}
{%- macro meta(st) -%}
<p class="meta">
  <span class="src">{{ st.source }}</span>
  <span class="lang">{{ st.lang|upper }}</span>
  <time datetime="{{ st.published }}">{{ st.published_display }}{% if ':' in st.published_display %} Uhr{% endif %}</time>
  <a class="orig" href="{{ st.url }}" rel="noopener">{{ 'Zum Artikel' if st.lang == 'de' else 'Read original' }}&nbsp;&rarr;</a>
  <a class="sid" href="#{{ st.id }}" title="Story-ID für Feedback">#{{ st.id }}</a>
</p>
{%- endmacro -%}
{%- macro follow(st) -%}
{%- if st.update_note %}
<p class="update"><strong>{{ 'Neu:' if st.lang == 'de' else 'New:' }}</strong>{{ st.update_note }}</p>
{%- endif %}
{%- if st.followups %}
<div class="earlier">
  <span class="earlier-label">{{ 'Bisher berichtet' if st.lang == 'de' else 'Earlier coverage' }}</span>
  <ul>{% for f in st.followups %}<li><a href="{{ f.href }}"><span class="fdate">{{ f.date[8:10]|int }}.{{ f.date[5:7]|int }}.</span> {{ f.headline }}</a></li>{% endfor %}</ul>
</div>
{%- endif %}
{%- endmacro -%}
{%- macro figure(img) -%}
<figure class="pic">
  <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy" referrerpolicy="no-referrer" onerror="hb_noimg(this)">
  {%- if img.credit %}<figcaption>Foto: {{ img.credit }}</figcaption>{% endif %}
</figure>
{%- endmacro -%}
{%- macro emblem(cls) -%}
<svg class="{{ cls }}" viewBox="0 0 160 72" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M2 54 C 30 46, 52 44, 80 47 S 130 50, 158 42" opacity=".55"/>
  <path d="M10 66 q 8 -4 16 0 t 16 0 t 16 0 t 16 0 t 16 0 t 16 0 t 16 0 t 16 0 t 16 0" opacity=".7"/>
  <!-- Kaiserpfalz: the arcade wall with its paired round arches -->
  <path d="M14 56 V 30 H 70 V 56"/>
  <path d="M14 30 l 4 -4 h 48 l 4 4"/>
  <path d="M21 50 V 41 a 5 5 0 0 1 10 0 V 50"/>
  <path d="M37 50 V 41 a 5 5 0 0 1 10 0 V 50"/>
  <path d="M53 50 V 41 a 5 5 0 0 1 10 0 V 50"/>
  <path d="M26 41 V 50 M42 41 V 50 M58 41 V 50" stroke-width="1"/>
  <path d="M18 50 H 66" stroke-width="1"/>
  <!-- Marienkirche on the hill: nave and the two eastern towers -->
  <path d="M90 50 V 34 L 104 26 L 118 34 V 50"/>
  <path d="M118 50 V 26 h 8 V 50"/>
  <path d="M118 26 l 4 -18 l 4 18"/>
  <path d="M132 50 V 22 h 9 V 50"/>
  <path d="M132 22 l 4.5 -20 l 4.5 20"/>
  <path d="M122 32 v 4 M136.5 28 v 4" stroke-width="1"/>
  <path d="M86 50 H 146"/>
</svg>
{%- endmacro -%}
