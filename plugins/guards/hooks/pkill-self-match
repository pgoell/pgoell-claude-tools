#!/usr/bin/env python3
# PreToolUse guard for Bash: deny `pkill -f` with a plain pattern, and
# `pgrep -f` with a plain pattern in an `until` or `while` condition.
#
# Why: Claude Code runs each Bash call through a `bash -c '<command>'` whose
# own command line contains the pattern, so `pkill -f 'uvicorn app'` matches
# and kills the agent's shell. The call then ends in "Exit code 144", even
# with `; true` after it. Over 14 days this host logged 83 such exits, 44 of
# them from `pkill -f`. A pattern whose first letter sits in a bracket class
# (`'[u]vicorn app'`) still matches the process but no longer matches its own
# text. A pattern passes only when it does not match the command's own text: a
# bracketed '[u]vicorn app' passes alone, but not beside a later 'uvicorn app'.
#
# The same self-match makes `until ! pgrep -f 'capture.sh'; do sleep 5; done`
# wait forever: pgrep always finds the shell running the loop. A one-shot
# `pgrep -f` only prints one extra PID, so it passes.
#
# Fails open: a command shlex cannot parse (stray quote, heredoc) passes.
import json
import re
import shlex
import sys

SEPARATORS = {";", "&&", "||", "|", "&", "(", ")"}
# Options that take a value, so the token after them is not the pattern.
SHORT_WITH_VALUE = set("dgGPstuUF")
LONG_WITH_VALUE = {
    "--signal", "--euid", "--uid", "--group", "--pgroup", "--parent",
    "--session", "--terminal", "--pidfile", "--ns", "--nslist", "--delimiter",
}

PKILL_REASON = (
    "Blocked: `pkill -f {pattern}` also matches the `bash -c` running this "
    "command, so it kills your own shell (exit 144). Instead, stop the process "
    "by port with `fuser -k <port>/tcp`, or run the pkill in a Bash call of its "
    "own with the first letter bracketed: `pkill -f '[{first}]{rest}'`."
)

PGREP_REASON = (
    "Blocked: `pgrep -f {pattern}` in a loop condition also matches the "
    "`bash -c` running this loop, so it always finds a process and the loop "
    "never ends. Bracket the first letter of the pattern so it cannot match "
    "itself: `until ! pgrep -f '[{first}]{rest}'`."
)


def segments(command):
    """Split a command into simple commands, respecting quotes."""
    lexer = shlex.shlex(command.replace("\n", ";"), posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    segment = []
    for token in lexer:
        if token in SEPARATORS:
            yield segment
            segment = []
        else:
            segment.append(token)
    yield segment


def self_matching_pattern(args):
    """Return the pattern when these pkill or pgrep args use -f."""
    full = False
    tokens = iter(args)
    for token in tokens:
        if token == "--":
            # Everything after `--` is the pattern, even when it starts with `-`.
            token = next(tokens, None)
            return token if full and token else None
        if token == "--full":
            full = True
        elif token in LONG_WITH_VALUE:
            next(tokens, None)
        elif token.startswith("--"):
            continue
        elif token.startswith("-") and len(token) > 1:
            full = full or "f" in token
            if token[-1] in SHORT_WITH_VALUE:
                next(tokens, None)
        else:
            return token if full else None
    return None


def own_text_matches(pattern, command):
    """True when the pattern matches the command's own text, so it hits the bash -c running it."""
    try:
        return re.search(pattern, command) is not None
    except re.error:
        return False


def main():
    command = json.load(sys.stdin).get("tool_input", {}).get("command", "")
    if "pkill" not in command and "pgrep" not in command:
        return
    try:
        parts = list(segments(command))
    except ValueError:
        return
    for part in parts:
        for i, token in enumerate(part):
            name = token.rsplit("/", 1)[-1]
            in_loop = {"until", "while"} & set(part[:i])
            if name != "pkill" and not (name == "pgrep" and in_loop):
                continue
            pattern = self_matching_pattern(part[i + 1 :])
            if pattern and own_text_matches(pattern, command):
                reason = (PKILL_REASON if name == "pkill" else PGREP_REASON).format(
                    pattern=shlex.quote(pattern), first=pattern[0], rest=pattern[1:]
                )
                print(json.dumps({"hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }}))
                return


main()
