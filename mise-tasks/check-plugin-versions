#!/usr/bin/env bash
#MISE description="Verify plugins changed since origin/master have bumped versions across manifests (Claude, Codex, Cursor)"
set -euo pipefail

BASE="origin/master"
MARKETPLACE=".claude-plugin/marketplace.json"
SEMVER_RE='^[0-9]+\.[0-9]+\.[0-9]+$'

# Returns 0 when plain X.Y.Z version $1 is strictly greater than $2.
version_gt() {
  local IFS='.'
  local a=($1) b=($2)
  local i
  for i in 0 1 2; do
    if ((10#${a[i]} > 10#${b[i]})); then return 0; fi
    if ((10#${a[i]} < 10#${b[i]})); then return 1; fi
  done
  return 1
}

if ! git rev-parse --verify --quiet "$BASE" >/dev/null; then
  echo "error: $BASE not found locally, fetch the remote before pushing" >&2
  exit 1
fi

# Plugin names touched on this branch. The three-dot range diffs HEAD against
# the merge base, so changes master gained since branching do not count.
# --no-renames keeps both sides of a cross-plugin file move in the list;
# with rename detection the source plugin would escape the check.
changed_plugins="$(git diff --name-only --no-renames "$BASE...HEAD" -- plugins/ | awk -F/ 'NF >= 3 { print $2 }' | sort -u)"

if [ -z "$changed_plugins" ]; then
  echo "No plugin changes relative to $BASE, nothing to check"
  exit 0
fi

# Compares the version at HEAD against the version at $BASE for one manifest
# site. $1 = plugin name, $2 = label for output, $3 = HEAD version (may be
# empty), $4 = BASE version (may be empty). Returns via global `status`.
check_site() {
  local name="$1" label="$2" head_version="$3" base_version="$4"

  if [ -z "$head_version" ]; then
    echo "✗ $name: $label missing a version" >&2
    status=1
    return
  fi

  if ! [[ $head_version =~ $SEMVER_RE ]]; then
    echo "✗ $name: $label version \"$head_version\" is not plain X.Y.Z semver" >&2
    status=1
    return
  fi

  if [ -z "$base_version" ]; then
    echo "✓ $name: $label new at $head_version"
    return
  fi

  if version_gt "$head_version" "$base_version"; then
    echo "✓ $name: $label $base_version → $head_version"
  else
    echo "✗ $name: $label changed but version not bumped ($BASE: $base_version, HEAD: $head_version)" >&2
    status=1
  fi
}

status=0
for name in $changed_plugins; do
  if ! git cat-file -e "HEAD:plugins/$name" 2>/dev/null; then
    echo "- $name: removed at HEAD, skipping"
    continue
  fi

  # Site 1: .codex-plugin/plugin.json: every Codex manifest in this repo
  # declares a version, so this site is always required.
  codex_manifest="plugins/$name/.codex-plugin/plugin.json"
  head_codex_json="$(git show "HEAD:$codex_manifest" 2>/dev/null || true)"
  if [ -z "$head_codex_json" ]; then
    echo "✗ $name: $codex_manifest missing at HEAD" >&2
    status=1
  else
    head_codex_version="$(printf '%s' "$head_codex_json" | jq -r '.version // empty')"
    base_codex_json="$(git show "$BASE:$codex_manifest" 2>/dev/null || true)"
    base_codex_version="$(printf '%s' "$base_codex_json" | jq -r '.version // empty' 2>/dev/null || true)"
    check_site "$name" ".codex-plugin/plugin.json" "$head_codex_version" "$base_codex_version"
  fi

  # Site 2: .claude-plugin/plugin.json: only checked when this file already
  # declares a version. Some plugins (atlassian, google-workspace) omit it
  # and read their version from marketplace.json instead; that's exempt here.
  claude_manifest="plugins/$name/.claude-plugin/plugin.json"
  head_claude_json="$(git show "HEAD:$claude_manifest" 2>/dev/null || true)"
  head_claude_version="$(printf '%s' "$head_claude_json" | jq -r '.version // empty' 2>/dev/null || true)"
  if [ -z "$head_claude_version" ]; then
    echo "- $name: .claude-plugin/plugin.json has no version field, reads from marketplace.json, skipping this site"
  else
    base_claude_json="$(git show "$BASE:$claude_manifest" 2>/dev/null || true)"
    base_claude_version="$(printf '%s' "$base_claude_json" | jq -r '.version // empty' 2>/dev/null || true)"
    check_site "$name" ".claude-plugin/plugin.json" "$head_claude_version" "$base_claude_version"
  fi

  # Site 4: .cursor-plugin/plugin.json, generated by sync-cursor-manifests.
  # Checked only for plugins offered in Cursor (the manifest exists at HEAD);
  # deprecated, prose-styles, guards, and issue-loop have none.
  cursor_manifest="plugins/$name/.cursor-plugin/plugin.json"
  head_cursor_json="$(git show "HEAD:$cursor_manifest" 2>/dev/null || true)"
  if [ -z "$head_cursor_json" ]; then
    echo "- $name: no .cursor-plugin/plugin.json, not offered in Cursor, skipping this site"
  else
    head_cursor_version="$(printf '%s' "$head_cursor_json" | jq -r '.version // empty')"
    base_cursor_json="$(git show "$BASE:$cursor_manifest" 2>/dev/null || true)"
    base_cursor_version="$(printf '%s' "$base_cursor_json" | jq -r '.version // empty' 2>/dev/null || true)"
    check_site "$name" ".cursor-plugin/plugin.json" "$head_cursor_version" "$base_cursor_version"
  fi

  # Site 3: this plugin's entry in the root marketplace.json.
  head_market_json="$(git show "HEAD:$MARKETPLACE" 2>/dev/null || true)"
  head_market_version="$(printf '%s' "$head_market_json" | jq -r --arg n "$name" '.plugins[] | select(.name == $n) | .version // empty' 2>/dev/null || true)"
  base_market_json="$(git show "$BASE:$MARKETPLACE" 2>/dev/null || true)"
  base_market_version="$(printf '%s' "$base_market_json" | jq -r --arg n "$name" '.plugins[] | select(.name == $n) | .version // empty' 2>/dev/null || true)"
  check_site "$name" "$MARKETPLACE entry" "$head_market_version" "$base_market_version"
done

exit "$status"
